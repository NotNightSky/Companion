{
  "schemaVersion": 1,
  "id": "companion",
  "version": "${version}",
  "name": "companion",
  "description": "Have your own companion!!",
  "authors": ["NotNightSky"],
  "contact": {
    "homepage": "https://modrinth.com/mod/companion2d",
    "sources": "https://github.com/NotNightsky/companion",
    "issues": "https://github.com/NotNightsky/companion/issues"
  },
  "license": "MIT",
  "icon": "assets/companion/companion.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "org.notnightsky.companion.CompanionClient"
    ],
    "modmenu": [
      "org.notnightsky.companion.ModmenuImpl"
    ]
  },
  "mixins": [
    {
      "config": "companion.client.mixins.json",
      "environment": "client"
    }
  ],
  "custom": {
    "modmenu": {
      "links": {
        "companion.wiki": "https://github.com/NotNightsky/companion/wiki"
      },
      "update_checker": true
    }
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "modmenu": ">=${modmenu_version}"
  }
}
